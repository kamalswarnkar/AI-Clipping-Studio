# ---------------------------------------------------------------------------
# AI Clipping Studio - configuration
# Copy to .env and edit. Everything below runs fully locally by default.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API (frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- FFmpeg -----------------------------------------------------------------
# Leave blank to auto-resolve: $FFMPEG_BIN -> PATH -> ./tools/ffmpeg/bin -> imageio-ffmpeg
FFMPEG_BIN=
FFPROBE_BIN=

# --- Provider selection -----------------------------------------------------
# transcription: faster_whisper | null
# llm:           ollama | null
# vision:        ollama | null
# diarization:   clustering | pyannote | null
TRANSCRIPTION_PROVIDER=faster_whisper
LLM_PROVIDER=ollama
VISION_PROVIDER=ollama
DIARIZATION_PROVIDER=clustering

# --- Ollama (fully local LLM + vision) --------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT=600
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2
OLLAMA_KEEP_ALIVE=10m
# Retries when the model returns unparseable / schema-invalid JSON.
OLLAMA_JSON_RETRIES=3

# --- Speech recognition (faster-whisper, CPU friendly) ----------------------
# model: tiny | base | small | medium | large-v3  (small = good CPU tradeoff)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
# Blank = auto-detect language
WHISPER_LANGUAGE=
WHISPER_VAD_FILTER=true

# --- Pipeline tuning --------------------------------------------------------
CLIP_COUNT_DEFAULT=15
CLIP_MIN_DURATION=10
CLIP_MAX_DURATION=60
# Size of the cheap candidate pool handed to the LLM stage.
CANDIDATE_POOL_MAX=80
# Candidates sent to the LLM after cheap scoring.
CANDIDATE_LLM_MAX=40
LLM_EVAL_BATCH=4
# Visual reasoning is bounded: only the strongest candidates get a vision call.
VISION_ENABLED=true
VISION_MAX_CANDIDATES=20
VISION_FRAMES_PER_CANDIDATE=4
# Duplicate suppression
DEDUPE_IOU_THRESHOLD=0.35
DEDUPE_TEXT_SIMILARITY=0.72

# --- Rendering --------------------------------------------------------------
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_FPS=30
RENDER_CRF=20
RENDER_PRESET=veryfast
RENDER_AUDIO_LUFS=-14
# Parallel clip renders. Keep <= physical cores / 2.
RENDER_WORKERS=2
SUBTITLE_FONT=Arial
SUBTITLE_FONT_SIZE=68

# --- Job system -------------------------------------------------------------
JOB_WORKERS=2
JOB_MAX_RETRIES=2
