# ---------------------------------------------------------------------------
# AI Clipping Studio - configuration
# Copy to .env and edit. Everything below runs fully locally by default.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API (frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- FFmpeg -----------------------------------------------------------------
# Leave blank to auto-resolve: $FFMPEG_BIN -> PATH -> ./tools/ffmpeg/bin -> imageio-ffmpeg
FFMPEG_BIN=
FFPROBE_BIN=

# --- Provider selection -----------------------------------------------------
# transcription: faster_whisper | null
# llm:           ollama | null
# vision:        ollama | null
# diarization:   clustering | pyannote | null
TRANSCRIPTION_PROVIDER=faster_whisper
LLM_PROVIDER=ollama
VISION_PROVIDER=ollama
DIARIZATION_PROVIDER=clustering

# --- Ollama (fully local LLM + vision) --------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT=600
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2
OLLAMA_KEEP_ALIVE=10m
# Retries when the model returns unparseable / schema-invalid JSON.
OLLAMA_JSON_RETRIES=3

# --- Speech recognition (faster-whisper, CPU friendly) ----------------------
# tiny | base | small | medium | large-v3
# base is ~2.8x faster than small with near-identical word output on clear
# speech, and is what keeps a 17-min video inside the 10-minute budget.
# Use small/medium if you need better accuracy on proper nouns or noisy audio.
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
# beam_size=1 (greedy) is roughly 2x faster than 5 with a small accuracy cost.
WHISPER_BEAM_SIZE=1
# 0 = let CTranslate2 choose. Set to your physical core count if it guesses badly.
WHISPER_CPU_THREADS=0
# Blank = auto-detect language
WHISPER_LANGUAGE=
WHISPER_VAD_FILTER=true
# Names and terms that recur across your videos, comma separated. Whisper is
# biased toward these. This is the one thing that reliably fixes unusual proper
# nouns -- a larger model does not. Per-video names go in the upload screen's
# "Names and terms in this video" box instead; both are used together.
WHISPER_VOCABULARY=
# After summarising the video, transcribe once more biased toward the names the
# summary found. A name mangled in one sentence is usually correct in another,
# so this corrects proper nouns without anyone having to know them in advance.
# Costs one extra transcription pass.
WHISPER_REFINE_PASS=true

# --- Pipeline tuning --------------------------------------------------------
CLIP_COUNT_DEFAULT=15
CLIP_MIN_DURATION=20
CLIP_MAX_DURATION=60
# Size of the cheap candidate pool handed to the LLM stage.
CANDIDATE_POOL_MAX=80
# Candidates sent to the LLM after cheap scoring.
CANDIDATE_LLM_MAX=32
LLM_EVAL_BATCH=6
# Concurrent requests to Ollama. 2-3 gives the best wall-clock on one GPU.
LLM_PARALLEL=3
# Cap on generated tokens per evaluated candidate. Terse reasons keep this stage
# fast; this is the main speed lever after vision.
LLM_EVAL_TOKENS_PER_CANDIDATE=150
# Visual reasoning via a multimodal model is the single most expensive stage
# (~25s per candidate). It is OFF by default: OpenCV already supplies faces,
# motion and scene cuts for free, and conflict intensity is detected far more
# cheaply from audio + speaker turns. Turn it on only if you want semantic
# visual descriptions and can afford the time.
VISION_ENABLED=false
VISION_MAX_CANDIDATES=10
VISION_FRAMES_PER_CANDIDATE=2
# Duplicate suppression
DEDUPE_IOU_THRESHOLD=0.35
DEDUPE_TEXT_SIMILARITY=0.72

# --- Rendering --------------------------------------------------------------
# Clips keep the source aspect ratio by default. RENDER_WIDTH/RENDER_HEIGHT
# apply only when a project asks for the 9:16 crop, which discards whatever
# falls outside the tall frame.
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_FPS=30
RENDER_CRF=20
RENDER_PRESET=veryfast
RENDER_AUDIO_LUFS=-14
# Parallel clip renders. Keep <= physical cores / 2.
RENDER_WORKERS=3
SUBTITLE_FONT=Arial
# Caption size, given for a 1920-tall frame and scaled to whatever frame is
# actually rendered, so captions keep the same share of the picture at any
# resolution. 120 is about 6% of frame height. Line length follows from this:
# a bigger font means fewer characters per line, so text never runs past the
# margins.
SUBTITLE_FONT_SIZE=120
# Many sources already have captions burned in. The 9:16 crop would slice them
# down the middle, so the band is detected and cropped away before reframing.
# At the original aspect ratio nothing is cut, and the app's own captions are
# placed above the band instead.
REMOVE_SOURCE_SUBTITLES=true

# --- Attention / conflict scoring -------------------------------------------
# Short-form retention is decided in the first seconds, so the opening of a clip
# is scored separately and weighted into selection.
OPENING_WINDOW_SECONDS=3.0
# How much the opening hook strength counts toward the final candidate score.
OPENING_WEIGHT=0.22
# Weight for conflict intensity (shouting, interruption, rapid exchange).
CONFLICT_WEIGHT=0.18

# --- Job system -------------------------------------------------------------
JOB_WORKERS=2
JOB_MAX_RETRIES=2

# --- Hooks and captions -----------------------------------------------------
# hooks.txt and caption.txt name the video as the primary source of truth, so
# each rendered clip is watched by the vision model before its hooks and
# caption are written. Costs roughly 20-45s per clip. Set false to write from
# the transcript and context alone.
COPY_VISION_ENABLED=true
COPY_VISION_FRAMES=3
